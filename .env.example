# CRM lead intake — the API route /api/lead forwards submissions here (server-side only).
# Full intake URL, e.g. https://your-crm-domain/api/v1/public/intake/leads
CRM_LEAD_ENDPOINT=

# Secret key issued by the CRM, sent as `Authorization: Bearer <token>`.
# Required — a missing/wrong/revoked key returns 401. Keep it server-side only.
CRM_LEAD_TOKEN=

# Public site URL (used for canonical/sitemap/OpenGraph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://villa-sfiora.blackoak-re.com
