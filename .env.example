# CRM lead endpoint — the API route /api/lead forwards submissions here (server-side).
# Provide the full URL your CRM exposes for inbound leads.
CRM_LEAD_ENDPOINT=

# Optional: a bearer token / secret the CRM expects (sent as Authorization: Bearer <token>).
CRM_LEAD_TOKEN=

# Public site URL (used for canonical/sitemap/OpenGraph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://villa-sfiora.blackoak-re.com
